# --- Groq (specialist agents) ---
GROQ_API_KEY=
GROQ_RESEARCHER_MODEL=openai/gpt-oss-20b
GROQ_MATHEMATICIAN_MODEL=openai/gpt-oss-120b
GROQ_ML_ENGINEER_MODEL=openai/gpt-oss-120b
GROQ_EXPERIMENTER_MODEL=openai/gpt-oss-120b
GROQ_REVIEWER_MODEL=openai/gpt-oss-20b
GROQ_VERIFIER_MODEL=openai/gpt-oss-20b
GROQ_REPORT_MODEL=qwen/qwen3.8-27b

# --- NVIDIA (Deep Research Director + escalation) ---
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Research tools (all optional) ---
SEMANTIC_SCHOLAR_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
NCBI_API_KEY=

# --- Behaviour ---
RESEARCH_DB_PATH=data/research_team.db
ENABLE_CODE_EXECUTION=false
ENABLE_KNOWLEDGE_GRAPH=true
ESCALATION_CONFIDENCE_THRESHOLD=0.5
MAX_REFINE_ITERATIONS=1
MIN_PAPERS=3
SANDBOX_TIMEOUT=30

# --- Provider-safe context budgets ---
GROQ_REQUEST_BUDGET=7600
SPECIALIST_INPUT_BUDGET=5000
VERIFIER_INPUT_BUDGET=4000
REPORT_INPUT_BUDGET=5600
